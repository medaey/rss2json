#!/usr/bin/env python3

import sys
import json
import feedparser

def main():
    if len(sys.argv) < 2:
        print("Usage: rss2json <url>")
        sys.exit(1)

    url = sys.argv[1]
    feed = feedparser.parse(url)

    data = {
        "title": feed.feed.get("title"),
        "items": []
    }

    for e in feed.entries:
        data["items"].append({
            "title": e.get("title"),
            "link": e.get("link"),
            "published": e.get("published"),
            "summary": e.get("summary")
        })

    print(json.dumps(data, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()